/* ==========================================================================
   GOLDEN OBSIDIAN DESIGN SYSTEM - BASE & UTILITIES
   ========================================================================== */

/* Imports */
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap');

:root {
  /* Fonts */
  --font-heading: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

  /* Color Palette - Premium Obsidian Gold (Dark Mode Default) */
  --bg-primary: #080A10;
  --bg-secondary: #0F131E;
  --bg-card: #151A29;
  --bg-surface: rgba(15, 19, 30, 0.75);
  
  --accent-gold: #E5A93C;
  --accent-gold-rgb: 229, 169, 60;
  --accent-gold-dark: #B87C1E;
  --accent-gold-light: #F7D070;
  
  --text-primary: #F3F4F6;
  --text-secondary: #9CA3AF;
  --text-muted: #6B7280;
  
  /* Gradients */
  --gold-gradient: linear-gradient(135deg, #E5A93C 0%, #B87C1E 50%, #F7D070 100%);
  --gold-gradient-soft: linear-gradient(135deg, rgba(229, 169, 60, 0.1) 0%, rgba(184, 124, 30, 0.05) 100%);
  --dark-gradient: linear-gradient(180deg, #080A10 0%, #0F131E 100%);
  
  /* Effects */
  --gold-glow: 0 0 30px rgba(229, 169, 60, 0.25);
  --gold-glow-hover: 0 0 40px rgba(229, 169, 60, 0.45);
  --border-gold-glass: rgba(229, 169, 60, 0.15);
  --shadow-gold-glass: rgba(8, 10, 16, 0.5);
  --glass-blur: blur(16px);

  /* Spacing & Transitions */
  --transition-speed: 0.35s;
  --transition-cubic: cubic-bezier(0.4, 0, 0.2, 1);
  --max-width: 1200px;
}

[data-theme="light"] {
  /* Color Palette - Premium Warm Gold (Light Mode) */
  --bg-primary: #FAF9F5;
  --bg-secondary: #F3EFE2;
  --bg-card: #FFFFFF;
  --bg-surface: rgba(243, 239, 226, 0.75);
  
  --accent-gold: #966B24;
  --accent-gold-rgb: 150, 107, 36;
  --accent-gold-dark: #664611;
  --accent-gold-light: #C09A53;
  
  --text-primary: #1C1917;
  --text-secondary: #57534E;
  --text-muted: #8C8A82;
  
  /* Gradients */
  --gold-gradient: linear-gradient(135deg, #966B24 0%, #664611 50%, #C09A53 100%);
  --gold-gradient-soft: linear-gradient(135deg, rgba(150, 107, 36, 0.08) 0%, rgba(102, 70, 17, 0.04) 100%);
  --dark-gradient: linear-gradient(180deg, #FAF9F5 0%, #F3EFE2 100%);
  
  /* Effects */
  --gold-glow: 0 0 25px rgba(150, 107, 36, 0.12);
  --gold-glow-hover: 0 0 35px rgba(150, 107, 36, 0.22);
  --border-gold-glass: rgba(150, 107, 36, 0.25);
  --shadow-gold-glass: rgba(150, 107, 36, 0.06);
}

/* Custom Reset */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  overflow-x: hidden;
  line-height: 1.6;
  transition: background-color var(--transition-speed) var(--transition-cubic), 
              color var(--transition-speed) var(--transition-cubic);
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: var(--bg-primary);
}

::-webkit-scrollbar-thumb {
  background: var(--bg-secondary);
  border: 2px solid var(--bg-primary);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--accent-gold);
}

/* Typography & Headers */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.02em;
  color: var(--text-primary);
}

a {
  color: inherit;
  text-decoration: none;
  transition: all var(--transition-speed) var(--transition-cubic);
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

button, input, textarea, select {
  font-family: inherit;
  font-size: inherit;
  background: none;
  border: none;
  outline: none;
}

/* Structural Layout */
.container {
  width: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}

section {
  padding: 8rem 0;
  position: relative;
}

/* Shared Titles */
.section-header {
  text-align: center;
  margin-bottom: 5rem;
}

.section-subtitle {
  font-size: 0.9rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  background: var(--gold-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
  margin-bottom: 0.75rem;
}

.section-title {
  font-size: 3rem;
  font-weight: 800;
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -15px;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 3px;
  background: var(--gold-gradient);
  border-radius: 2px;
}

/* Helper Utilities */
.text-gold {
  background: var(--gold-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.bg-gold {
  background: var(--gold-gradient);
}

.glow-text {
  text-shadow: 0 0 15px rgba(229, 169, 60, 0.4);
}

.hidden-nav {
  transform: translateY(-100%);
}

/* Responsive Overrides */
@media (max-width: 992px) {
  section {
    padding: 6rem 0;
  }
  .section-title {
    font-size: 2.5rem;
  }
}

@media (max-width: 768px) {
  section {
    padding: 5rem 0;
  }
  .container {
    padding: 0 1.5rem;
  }
  .section-title {
    font-size: 2.2rem;
  }
}
