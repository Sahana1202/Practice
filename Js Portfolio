/* ==========================================================================
   PORTFOLIO JS MODULE - TYPEWRITER, FILTER ENGINE & TIMELINE PROGRESS
   ========================================================================== */

document.addEventListener('DOMContentLoaded', () => {
  initTypewriter();
  initProjectFilter();
  initTimelineHighlight();
});

/* 1. Typewriter Animation */
class Typewriter {
  constructor(element, words, wait = 3000) {
    this.element = element;
    this.words = words;
    this.txt = '';
    this.wordIndex = 0;
    this.wait = parseInt(wait, 10);
    this.type();
    this.isDeleting = false;
  }

  type() {
    const current = this.wordIndex % this.words.length;
    const fullTxt = this.words[current];

    // Determine typing speed
    let typeSpeed = 100;
    if (this.isDeleting) {
      typeSpeed /= 2; // Deleting is twice as fast
    }

    if (!this.isDeleting && this.txt === fullTxt) {
      // Pause at full word
      typeSpeed = this.wait;
      this.isDeleting = true;
    } else if (this.isDeleting && this.txt === '') {
      this.isDeleting = false;
      this.wordIndex++;
      typeSpeed = 500; // Small delay before starting next word
    } else {
      // Add or remove character
      this.txt = this.isDeleting 
        ? fullTxt.substring(0, this.txt.length - 1) 
        : fullTxt.substring(0, this.txt.length + 1);
    }

    this.element.innerHTML = `<span class="txt">${this.txt}</span><span class="cursor">|</span>`;

    setTimeout(() => this.type(), typeSpeed);
  }
}

function initTypewriter() {
  const typewriterEl = document.getElementById('typewriter');
  if (typewriterEl) {
    const words = [
      'Full Stack Developer.',
      'Backend Systems Specialist.',
      'UI/UX Visual Artisan.',
      'Robust Problem Solver.'
    ];
    new Typewriter(typewriterEl, words, 2500);
  }
}

/* 2. Fluid Project Filtering Engine */
function initProjectFilter() {
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Set active button
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filterValue = btn.getAttribute('data-filter');

      projectCards.forEach(card => {
        const category = card.getAttribute('data-category');
        
        // Remove existing classes
        card.classList.remove('fade-out', 'fade-in');

        if (filterValue === 'all' || category === filterValue) {
          card.style.display = 'flex';
          setTimeout(() => {
            card.classList.add('fade-in');
          }, 50);
        } else {
          card.classList.add('fade-out');
          setTimeout(() => {
            card.style.display = 'none';
          }, 350); // Matches transitions of fade-out
        }
      });
    });
  });
}

/* 3. Experience Timeline Highlight on Viewport Intersection */
function initTimelineHighlight() {
  const timelineNodes = document.querySelectorAll('.timeline-node');
  
  const timelineObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const marker = entry.target.querySelector('.timeline-marker');
      if (entry.isIntersecting) {
        entry.target.classList.add('node-active');
        if (marker) marker.classList.add('bg-gold', 'animate-pulse-gold');
      }
    });
  }, {
    root: null,
    threshold: 0.3,
    rootMargin: '0px 0px -100px 0px'
  });

  timelineNodes.forEach(node => timelineObserver.observe(node));
}
